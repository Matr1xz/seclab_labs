# results.config
# 
# Local and remote nmap results, reflecting HTTPS and MYSQL ports
remote_nmap_443 = remote_ws:nmap.stdout : CONTAINS : open  https 
local_nmap_443 = ws1:nmap.stdout : CONTAINS : open  https
local_nmap_sql = ws1:nmap.stdout : CONTAINS : open  mysql
reach_internet = ws1:wget.stdout : FILE_REGEX : www.google.com .*index.html.*saved
remote_wget_ws2 = remote_ws:wget.stdout : CONTAINS : Connecting to 198.18.1.194:80... failed:

