web-mysql = client:.bash_history : CONTAINS : sudo mysql -u root < ./src/users_account.sql
web-php = client:.bash_history : CONTAINS : sudo cp ./src/html/* /var/www/html/
filebeat-IP = client:cat.stdout : CONTAINS : 172.0.0.3:5044
filebeat-PATH = client:cat.stdout : CONTAINS : /var/log/apache2/access.log
logstash-service = server:.bash_history : CONTAINS : sudo systemctl start logstash
elastic-service = server:.bash_history : CONTAINS : sudo systemctl start elasticsearch
kibana-service = server:.bash_history : CONTAINS : sudo systemctl start kibana
view-elk = server:cat.stdout : CONTAINS : user1
