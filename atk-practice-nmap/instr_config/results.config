host_discovery = mycomputer:nmap.stdin : CONTAINS : nmap -sP 172.25.0.0
port_scan_service_detect = mycomputer:.bash_history : CONTAINS : nmap -p 80,432,22
auto_vs_fast_scan = mycomputer:nmap.stdin : CONTAINS : nmap --script=vuln
advanced_os_smb_scan = mycomputer:nmap.stdin : CONTAINS : nmap -T4 -A --script=smb-vuln*
