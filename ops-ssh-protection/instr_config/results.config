_nmap1 = attack:nmap.stdout : CONTAINS : Nmap done: 256
_nmap2 = attack:nmap.stdout : CONTAINS : OpenSSH 7.2p2
_file_view_ssh = attack:ssh.stdout : TOKEN : 4 : STARTSWITH : My string is:
hydra = attack:hydra.stdout : CONTAINS : 1 of 1 target successfully completed
sshguard-config = server:cat.stdout : CONTAINS : ARGS="-a 10 -p 60 -s 60"
sshguard-block = server:iptables.stdout : CONTAINS : ssh-protection.attack.student.some_network
sshpot-config = server:cat.stdout : CONTAINS : #define LOGFILE         "sshpot_auth.log"
sshpot-log = server:cat.stdout : CONTAINS : 172.20.0.2
