#DOC: Check Dns request


check_dns = client:dig.stdout : CONTAINS : 192.168.12.30
#DOC: check key generator

check_key_conf = server:cat.stdout : CONTAINS : .key
#DOC: check zone signed
check_sign_zone = server:cat.stdout : CONTAINS : .signed
#DOC: check config
check_config = server:./config_check : CONTAINS : OK
#DOC: check dns request with dnssec
check_dnssec_client = client:dig.stdout : CONTAINS : RRSIG
