# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: Which network protocol appears the most in the PCAP file?

eth0_protocol = tshark.stdout : CONTAINS : ICMPv6
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: Which IP address is sending DNS queries for the domain count.typora.io?

eth0_dns = tshark.stdout : CONTAINS : 172.16.0.51
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What is the manufacturer of the device based on the source MAC address in the STP packet?

eth0_stp = tshark.stdout : CONTAINS : Huawei
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What is the name of the server sending signals in the Browser protocol?

eth0_browser = tshark.stdout : CONTAINS : ITCAST-16689
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: In the NBNS protocol, what is the name of the device trying to find the IP address of the machine?

eth0_nbns = tshark.stdout : CONTAINS : NPIB594E3
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: Count the number of ARP request/reply packets in the PCAP file

eth0_arp = tshark.stdout : CONTAINS : 17
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What is the protocol identifier (Ethertype) for IPv6?

eth0_ipv6 = tshark.stdout : CONTAINS : 0x000086dd
