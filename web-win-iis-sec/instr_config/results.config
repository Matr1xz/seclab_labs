setup_iis = share/result.txt : FILE_REGEX : [\s\S]*http[\s\S]*localhost[\s\S]*GET[\s\S]*200[\s\S]*text\/html[\s\S]*
virtual_host = share/result.txt : FILE_REGEX : [\s\S]*http[\s\S]*ptit123\.com[\s\S]*GET[\s\S]*200[\s\S]*text[\s\S]*html[\s\S]*
ssl = share/result.txt : FILE_REGEX : .*https.*ptit123.com.*200.*
deny_url = share/result.txt : FILE_REGEX : .*HTTP Error 404.5 - Not Found.*The request filtering module is configured to deny the URL sequence.*
deny_ip = share/result.txt : FILE_REGEX : .*403 - Forbidden: Access is denied.*You do not have permission to view this directory or page using the credentials that you supplied.*
