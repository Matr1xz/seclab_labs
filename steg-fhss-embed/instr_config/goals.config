to_bits = boolean : _to_bits_stdin and _to_bits_stdout
fsk = boolean : _modulate_fsk_in and _modulate_fsk_out
embed = boolean : _embed_message_in and _embed_message_out
extract = boolean : _extract_message_in and _extract_message_out
size-change = boolean : _size_check_in and _size_check_out
mse = boolean : _mse_good or _mse_ok
