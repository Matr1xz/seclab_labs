#DOC: Split video into components such as audio and frames
extract_audio_and_frames = dct-video-stego:ffmpeg.stdout : CONTAINS : Output #0, image2, to 'frames/frame_%04d.png'

_split_info1 = dct-video-stego:split_info.py.stdin : CONTAINS : info.txt
_split_info2 = dct-video-stego:split_info.py.stdout : CONTAINS : Line 4 saved to /home/ubuntu/line_4.txt

_create_stego_frames1 = dct-video-stego:extract_frames.sh.stdin : CONTAINS : video.mp4 4
_create_stego_frames2 = dct-video-stego:extract_frames.sh.stdout : CONTAINS : Successfully extracted 4 frames from video.mp4

#DOC: Hide information fragments into split frames
hide_info = dct-video-stego:batch_embed.sh.stdout : CONTAINS : Embedding line_4.txt into frame_4.png -> frame_4_stego.png

#DOC: Replace video frames with frames containing hidden information
insert_frames = dct-video-stego:replace_frames.sh.stdout : CONTAINS : Copied frame_4_stego.png to frames/frame_0004.png

_regenerate_video1 = dct-video-stego:ffmpeg.stdout : CONTAINS : Input #0, image2, from 'frames/frame_%04d.png'
_regenerate_video2 = dct-video-stego:ffmpeg.stdout : CONTAINS : Input #1, mp3, from 'audio.mp3'
_regenerate_video3 = dct-video-stego:ffmpeg.stdout : CONTAINS : Output #0, mp4, to 'output.mp4'


