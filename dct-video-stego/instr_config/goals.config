#DOC: Divide the information to be hidden into several parts
split_info = boolean : (_split_info1 and _split_info2)

#DOC: Extract some frames from video to hide information
create_stego_frames = boolean : (_create_stego_frames1 and _create_stego_frames2)

#DOC: Synthesize frames and audio into video
regenerate_video = boolean : (_regenerate_video1 and _regenerate_video2 and _regenerate_video3)
