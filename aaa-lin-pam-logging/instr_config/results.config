# results.config
# 
# Please see the Labtainer Lab Designer User Guide

_debug_conf = aaa-lin-pam-logging:cat.stdout : FILE_REGEX : ^auth\s+required\s+pam_debug.so
_debug_auth_suc = aaa-lin-pam-logging:tail.stdout : FILE_REGEX : Accepted password for.*from 172.16.10.3
_debug_auth_fail = aaa-lin-pam-logging:tail.stdout : FILE_REGEX : authentication failure.*logname.*uid.*rhost=172.16.10.3
_compile_pam_cus = aaa-lin-pam-logging:gcc.stdin : CONTAINS : -fPIC -shared -o pam_custom.so pam_custom.c -lpam
_pam_custom_conf = aaa-lin-pam-logging:cat.stdout : FILE_REGEX : ^auth\s+required\s+pam_custom.so
_custom_log_suc = aaa-lin-pam-logging:tail.stdout : FILE_REGEX : pam_custom.*login detected: ubuntu
_custom_log_fail = aaa-lin-pam-logging:tail.stdout : FILE_REGEX : pam_custom.*Unauthorized user
