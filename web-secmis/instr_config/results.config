# results.config
# 
# Please see the Labtainer Lab Designer User Guide
password     = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Password
login_admin  = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Login Admin
login_jim    = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Login Jim
score_board          = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Score Board
error_handling       = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Error Handling
deprecated_interface = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Deprecated Interface
premium_paywall      = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Premium Paywall
admin_section        = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Admin Section
forged_feedback      = web-secmis-server:.local/result/journalctl.stdout : CONTAINS : Forged Feedback
# Read collected ZAP reports directly; offline grader skips pregrade.sh.
zap_report_spider    = web-secmis:Desktop/report.html : CONTAINS : ZAP Scanning Report
zap_report_final     = web-secmis:Desktop/report_zap.html : CONTAINS : ZAP Scanning Report
