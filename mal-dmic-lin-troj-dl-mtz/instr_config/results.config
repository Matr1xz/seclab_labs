Execute_malware = strace.stdout : CONTAINS : execve("./madoc.elf", ["./madoc.elf"]
File_strace = cat.stdout : CONTAINS : /tmp/log_de.log
_network1 = cat.stdout : CONTAINS : connect(3, {sa_family=AF_INET, sin_port=htons(8007), sin_addr=inet_addr("122.10.24.112")}, 16)
_network2 = cat.stdout : CONTAINS : socket(AF_INET, SOCK_STREAM, IPPROTO_IP)
_network3 = cat.stdout : CONTAINS : sendto
Tcpdump = tcpdump.stdout : CONTAINS : 122.10.24.112.8007
Wireshark = .bash_history : CONTAINS : wireshark
_parameters = cat.stdout : CONTAINS : Khoa ATTT PTIT
