# results.config
# 
# Please see the Labtainer Lab Designer User Guide
_firewall = client:client_result.txt : CONTAINS : firewall_ok
_https_port = web_server:/etc/nginx/sites-available/default : CONTAINS : 443 ssl
_https_cert = web_server:/etc/nginx/sites-available/default : CONTAINS : ssl_certificate
_folder = web_server:/var/log/nginx/error.log : CONTAINS : forbidden
_limit = web_server:/var/log/nginx/error.log : CONTAINS : zone
_header = client:client_result.txt : CONTAINS : nosniff
