#DOC:Successfully installed the isc-dhcp-server package on the server
dhcp-conf = server:/var/log/syslog : CONTAINS : Server starting service

#DOC:Successfully configured Vendor Class Identifier (VCI) on the client
VCI-client-conf = client:/etc/dhcp/dhclient.conf : CONTAINS : send vendor-class-identifier

#DOC:Successfully configured Vendor Class Identifier (VCI) on the Iot
VCI-Iot-conf = iot:/etc/dhcp/dhclient.conf : CONTAINS : send vendor-class-identifier 

#DOC: The client successfully applied for an IP address from the dhcp-server
client-check = client:client.stdout : FILE_REGEX : DHCPACK of 40\.40\.1\.\d{1,3} from 40\.40\.1\.5

#DOC: The iot successfully applied for an IP address from the dhcp-server
IoT-check = iot:iot.stdout : FILE_REGEX : DHCPACK of 40\.40\.1\.\d{1,3} from 40\.40\.1\.5
