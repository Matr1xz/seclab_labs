# results.config

# Task 1: SYN Flood
_syn_recv_count = server:netstat.stdout : STRING_COUNT : SYN_RECV

# Task 2: TCP RST
_rst_detected = client:telnet.stdout : FILE_REGEX : ubuntu@server.*Connection closed by foreign host

# Task 3: Session Hijacking
_file_deleted = server:prestop.stdout : CONTAINS : FILE_DELETED

# Task 4: Reverse Shell
_shell_established = attacker:nc.stdout : CONTAINS : ubuntu@server
