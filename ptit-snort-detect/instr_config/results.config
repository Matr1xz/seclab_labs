# results.config
# 
# Please see the Labtainer Lab Designer Guide
#
#  nmap results, note which ports are open
#
# results of nmap scans
_ssh_open = client:nmap.stdout : TOKEN : 2 : STARTSWITH : 22/tcp
_telnet_open = client:nmap.stdout : TOKEN : 2 : STARTSWITH : 23/tcp
creuserlist = client:crunch.stdin : CONTAINS : user.txt
crepasslist = client:crunch.stdin : CONTAINS : pass.txt
hydraattack = client:hydra.stdout : CONTAINS : target successfully completed
fileview = client:ssh.stdout : TOKEN : 4 : STARTSWITH : My string is:
bruforSSH = server:snort.stdout : CONTAINS : Multiple Failed SSH Logins
SQLinjec = server:snort.stdout : CONTAINS : SQL Injection
XSS = server:snort.stdout : CONTAINS : XSS
