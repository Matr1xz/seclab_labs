echo_env = .bash_history : CONTAINS : echo $PROMPT_COMMAND
write_bashrc = /etc/bash.bashrc : CONTAINS : export PROMPT_COMMAND
reload_bash = .bash_history : CONTAINS : exec bash
rsyslog_config = /etc/rsyslog.d/50-default.conf : CONTAINS : local6.* /var/log/user_commands.log
logrotate_config = .bash_history : CONTAINS : logrotate.d/user_commands
restart_rsyslog = .bash_history : CONTAINS : sudo systemctl restart rsyslog
check_log = /var/log/user_commands.log : CONTAINS : user_commands.log
