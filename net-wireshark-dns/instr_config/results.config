_file_size = result.txt : SIZE
_hashcode = result.txt : SEARCH : MSV:{:S} : HAVESTRING : MSV
_src_port = result.txt : CONTAINS : DNS source port:53
_des_port = result.txt : CONTAINS : DNS destination port:53
dns_query = result.txt : CONTAINS : DNS query message sent to IP address:192.168.1.1
type_dns = result.txt : CONTAINS : Type of DNS:AAAA
number_answer = result.txt : CONTAINS : Number answer:2
