# --- Task 1: Nmap Scanning Results ---
_scan_service_snmp = client:nmap.stdout : CONTAINS : snmp
_scan_udp = client:nmap.stdout : CONTAINS : 161
_scan_tcp = client:nmap.stdout : CONTAINS : 8443/tcp
_scan_service_http = client:nmap.stdout : CONTAINS : http

# --- Task 2: SNMP Bruteforce and Enumeration Results ---
_brute_force = client:*.stdout : CONTAINS : pr1v4t3
_enum_info = client:*.stdout : CONTAINS : --username admin

# --- Task 3: Info Leak and Capture The Flag Results ---
_get_flag_result = client:*.stdout : TOKEN : LAST : HAVESTRING : flag is:

