# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: How many FTP control and FTP data packets In the pcap file?

ftp_packet_cnt = tshark.stdout : CONTAINS : 27
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What username does the client use to log in?

ftp_user = tshark.stdout : CONTAINS : csanders
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What FTP software and version is the client using?

ftp_version = tshark.stdout : CONTAINS : FlashFXP 3.4.0.1145
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What is the size of the requested file to be downloaded?

ftp_packet_size = tshark.stdout : CONTAINS : 4980924
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What is the total duration of the file transfer session?

ftp_trf_time = tshark.stdout : CONTAINS : 2.670640000
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What is the average size of each FTP-DATA packet?

ftp_packet_len = tshark.stdout : CONTAINS : 1506
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What file transfer mode is being used (ASCII or Binary)?

ftp_trf_mode = tshark.stdout : CONTAINS : TYPE I
