# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# Time stamp of log entry containing IP address
discover_lab = netmon:.bash_history : CONTAINS : wireshark
log-from-w1 = w3:/var/log/myhttplogfile.txt : LOG_TS : 202.25.4.2
# Use of wget -- will result in time stamp range: start-finish
wget-w1 = w1:wget.stdin : CONTAINS : 203.22.0.2
ping-w1 = wx:.bash_history : CONTAINS : ping 202.25.4.2
