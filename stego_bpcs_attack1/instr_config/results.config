gblur_video = .bash_history : CONTAINS : ffmpeg -i output_stego.mp4 -vf "gblur=sigma=1.0" -c:a copy destroyed_blur.mp4
check_video = .bash_history : CONTAINS : ffplay destroyed_blur.mp4
compare_video = .bash_history : CONTAINS : ffmpeg -i output_stego.mp4 -i destroyed_blur.mp4 -lavfi psnr="psnr_blur.log" -f null -
extract_gblur_video = .bash_history : CONTAINS : python3 pbcs_lsb_extract.py destroyed_blur.mp4
