_check_process_1 = cat.stdout : CONTAINS : brbbot.exe
_check_process_2 = cat.stdout : FILE_REGEX : [0-9]+/[0-9]+
_check_strings_1 = cat.stdout : CONTAINS : ZwQuerySystemInformation
_check_strings_2 = cat.stdout : CONTAINS : GetEnvironmentVariableA
