mo file Capture.pcapng bang wireshark
wireshark = user:wireshark.stdin : CONTAINS : Capture.pcapng
nmap = user:nmap.stdout : CONTAINS : ftp
hydra = user:hydra.stdout : CONTAINS : successfully completed
shellcode = server:/var/www/html/shell.php : CONTAINS : 192.168.0.27
netcat = user:nc.stdout : CONTAINS : Connection from [192.168.0.115] port
nc_root = user:nc.stdout : CONTAINS : root
vsftpd_conf_1 = server:/etc/vsftpd.conf : CONTAINS : max_login_fails=3
