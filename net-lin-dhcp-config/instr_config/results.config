#DOC: Is the dhcp server installed?
install-dhcp = dpkg.stdout : CONTAINS : isc-dhcp-server
#DOC: Is the network interface configuration successful?
interface-check = interface.stdout : CONTAINS : INTERFACESv4="eth0"
#DOC: Check DHCP options configuration
subnet-config = /etc/dhcp/dhcpd.conf : CONTAINS : subnet 192.168.0.0 netmask 255.255.255.0
