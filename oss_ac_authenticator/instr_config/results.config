google_authen_config = server:/etc/pam.d/sshd : CONTAINS : auth required pam_google_authenticator.so
pam_config = server:.bash_history : CONTAINS : google-authenticator
ssh_config_authen = server:/etc/ssh/sshd_config : CONTAINS : KbdInteractiveAuthentication yes
ssh_config_password = server:/etc/ssh/sshd_config : CONTAINS : #PasswordAuthentication yes
ssh_config_pam = server:/etc/ssh/sshd_config : CONTAINS : UsePAM yes
ssh_service_restart = server:.bash_history : CONTAINS : sudo systemctl restart ssh
ssh_access = server:/var/log/auth.log : CONTAINS : Accepted password for ubuntu
