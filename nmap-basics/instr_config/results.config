# results.config
# 
# Please see the Labtainer Lab Designer User Guide

_nmap_ping = mycomputer:nmap.stdin : CONTAINS : -sP

_nmap_scan_tcp = mycomputer:nmap.stdin : CONTAINS : -sT

_nmap_scan_udp = mycomputer:nmap.stdin : CONTAINS : -sU

_nmap_scan_syn = mycomputer:nmap.stdin : CONTAINS : -sS

_nmap_scan_syn_all = mycomputer:nmap.stdin : CONTAINS : -sS 172.25.0.0/24

_nmap_scan_os = mycomputer:nmap.stdin : CONTAINS : -O

_nmap_scan_servicedetails = mycomputer:nmap.stdin : CONTAINS : -sV

_nmap_scan_script = mycomputer:nmap.stdin : CONTAINS : --script=

_nmap_scan_output = mycomputer:nmap.stdin : CONTAINS : -o
