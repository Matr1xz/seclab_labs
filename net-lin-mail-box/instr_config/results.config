_main-cf = server:/etc/postfix/main.cf : CONTAINS : myhostname = mail.local
_client1-log = client1:.mailrc : CONTAINS : user1@mail.local
_client2-log = client2:.mailrc : CONTAINS : user2@mail.local
_send-mail = server:/var/log/mail.log : CONTAINS : to=<user2@mail.local>
_seen-mail = server:/var/log/mail.log : CONTAINS : imap-login: Login: user=<user2>
