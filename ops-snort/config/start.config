    GLOBAL_SETTINGS
    GRADE_CONTAINER snort
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED snort_mike_master_seed
    REGISTRY labattt2025
NETWORK LAN1
     MASK 192.168.1.0/24
     GATEWAY 192.168.1.101
NETWORK LAN2
     MASK 192.168.2.0/24
     GATEWAY 192.168.2.101
NETWORK LAN3
     MASK 192.168.3.0/24
     GATEWAY 192.168.3.101
NETWORK WAN
     MASK 203.0.113.0/24
     GATEWAY 203.0.113.101
NETWORK ISP_GW
     MASK 10.10.0.0/24
     GATEWAY 10.10.0.101
NETWORK REMOTE_LAN
     MASK 172.16.0.0/24
     GATEWAY 172.16.0.101
CONTAINER ws2
     USER mary
     X11 YES
     TERMINAL_GROUP 1
     ADD-HOST www.example.com:192.168.1.2
     LAN2 192.168.2.1
CONTAINER snort
     USER tom
     X11 YES
     TERMINAL_GROUP 1
     LAN3 192.168.3.1
CONTAINER isp
     USER ubuntu
     X11 NO
     TERMINALS -1
     WAN 203.0.113.1
     ISP_GW 10.10.0.1
CONTAINER web_server
     USER admin
     X11 NO
     TERMINAL_GROUP LOCAL
     LAN1 192.168.1.2
CONTAINER gateway
     USER ubuntu
     X11 NO
     TERMINAL_GROUP LOCAL
     LAN1 192.168.1.10
     LAN2 192.168.2.10
     LAN3 192.168.3.10
     WAN 203.0.113.10
CONTAINER remote_ws
     USER hank
     X11 YES
     TERMINAL_GROUP remote
     ADD-HOST www.example.com:203.0.113.10
     REMOTE_LAN 172.16.0.1
CONTAINER remote_gw
     USER admin
     X11 NO
     TERMINAL_GROUP remote
     REMOTE_LAN 172.16.0.10
     WAN 203.0.113.20
