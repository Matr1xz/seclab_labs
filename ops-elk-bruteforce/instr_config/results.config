mysql-db = client:.bash_history : CONTAINS : sudo mysql -u root < ./src/users_account.sql
web-php = client:.bash_history : CONTAINS : sudo cp ./src/html/* /var/www/html/
filebeat-path = client:cat.stdout : CONTAINS : /var/log/apache2/access.log
filebeat-IP = client:cat.stdout : CONTAINS : 172.0.0.3:5044
logstash = server:.bash_history : CONTAINS : sudo systemctl start logstash
elasticsearch = server:.bash_history : CONTAINS : sudo systemctl start elasticsearch
kibana = server:.bash_history : CONTAINS : sudo systemctl start kibana
attack-password = attacker:.bash_history : CONTAINS : python3 bruteforce_passwd.py -u user1 -p password.txt
bruteforce-logs = server:cat.stdout : CONTAINS : password=password1
