monitor_client = ossec:/root/.bash_history : CONTAINS : /var/ossec/bin/manage_agents
create_log = ossec:/root/.bash_history : CONTAINS : /var/ossec/logs/alerts/alerts.log
ssh_alert = ossec:/var/ossec/logs/alerts/alerts.log : CONTAINS : Rule: 5716
ssh_response = ossec:/var/ossec/logs/alerts/alerts.log : CONTAINS : Rule: 5551
port_listen = ossec:/var/ossec/logs/alerts/alerts.log : CONTAINS : Rule: 533
access_plan = ossec:/var/ossec/logs/alerts/alerts.log : CONTAINS : Accessed the business plan
failed_plan = ossec:/var/ossec/logs/alerts/alerts.log : CONTAINS : Attempt to access the business plan
client_wget = client1:/root/.bash_history : CONTAINS : wget
log_collector = client1:/root/.bash_history : CONTAINS : ldd ossec-logcollector

