#DOC: Successfully configured dhcp server service
dhcp-config = server:/etc/dhcp/dhcpd.conf : CONTAINS : fixed-address 20.20.0
#DOC: Check if the client receives the correct static IP?
ip-client = client:client.stdout : FILE_REGEX : DHCPACK of 20\.20\.0\.\d{1,3} from 20\.20\.0\.5
#DOC: Check the connection to the server
ping = client:ping.stdout : CONTAINS : tes from 20.20.0.5
