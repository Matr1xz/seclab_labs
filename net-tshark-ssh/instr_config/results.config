# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: How many SSH packets are in the pcap file?
ssh-packet-cnt = tshark.stdout : CONTAINS : 107
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What SSH version is being used by the client and server?

ssh-version = tshark.stdout : CONTAINS : SSH-2.0
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: How many failed login attempts occurred?

# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: How does the key exchange process take place?

ssh-key = tshark.stdin : CONTAINS : ssh.message_code
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: What are the sizes of the SSH packets?

ssh-packet-len = tshark.stdin : CONTAINS : frame.len
# results.config
# 
# Please see the Labtainer Lab Designer User Guide
#
# DOC: How long is the total duration of the SSH session?

ssh-ses-time = tshark.stdout : CONTAINS : 37.703903000
