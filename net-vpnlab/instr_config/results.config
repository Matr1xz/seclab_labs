_tcpdump_run = router:tcpdump.stdin : CONTAINS : tcpdump
_index_unenc = server:/var/log/myhttplogfile.txt : FILE_REGEX : 172\.25\.0\.\d.*GET /index\.html

_vpn_server = server:prestop.stdout : CONTAINS : SERVER_OVPN_RUNNING
_vpn_client = client:prestop.stdout : CONTAINS : CLIENT_OVPN_RUNNING

_index_vpn = server:/var/log/myhttplogfile.txt : FILE_REGEX : 10\.8\.0\.\d.*GET /index\.html
