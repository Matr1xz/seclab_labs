lsb_detect = .bash_history : CONTAINS : soxi secret_audio.wav
original_compare = .bash_history : CONTAINS : check_flag.sh extracted_original.txt
noise_attack = .bash_history : CONTAINS : sox -m secret_audio.wav synth whitenoise vol 0.001 damaged.wav
re_encode_attack = .bash_history : CONTAINS : ffmpeg -i secret_audio.wav -b:a 16k compressed_audio.mp3
inject_attack = .bash_history : CONTAINS : python3 inject_lsb_audio.py secret_audio.wav fake_flag.txt fake_audio.wav
unrecover = .bash_history : CONTAINS : python3 extract_lsb_audio.py damaged.wav > output.txt 
