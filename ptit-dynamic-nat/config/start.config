    GLOBAL_SETTINGS
    LAB_MASTER_SEED static-nat-lab_student_master_seed
    REGISTRY labattt2025
NETWORK LAN
     MASK 10.0.0.0/24
     GATEWAY 10.0.0.254
NETWORK WAN
     MASK 192.168.0.0/24
     GATEWAY 192.168.0.254
CONTAINER client
     USER ubuntu
     X11 YES
     TERMINAL_GROUP GR1
     LAN 10.0.0.2
CONTAINER isp
     USER ubuntu
     X11 YES
     TERMINAL_GROUP GR1
     WAN 192.168.0.2
CONTAINER router
     USER ubuntu
     X11 YES
     TERMINAL_GROUP GR1
     LAN 10.0.0.1
     WAN 192.168.0.1
